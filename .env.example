# ========================================================
# CONEXIÓN A BASE DE DATOS (HOSTINGER MYSQL)
# ========================================================
# En tu panel de Hostinger (hPanel):
# Ve a Bases de datos -> Administrador de bases de datos MySQL
# Crea una base de datos y coloca aquí la cadena de conexión:
DATABASE_URL="mysql://u123456789_usuario:tu_password@127.0.0.1:3306/u123456789_facturadb"

# ========================================================
# CONFIGURACIÓN DEL PAC (TIMBRADO)
# ========================================================
# 'mock' para pruebas/demo simulada, 'facturacom' para emitir con Factura.com
PAC_PROVIDER="mock"

# Configuración de Factura.com (cuando se active facturación real)
FACTURACOM_ENV="sandbox"
FACTURACOM_API_KEY=""
FACTURACOM_SECRET_KEY=""
FACTURACOM_SERIE="F"
